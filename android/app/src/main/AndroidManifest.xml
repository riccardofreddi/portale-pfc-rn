<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v4.3: allarmi esatti per i promemoria di scadenza a app chiusa
         ( USE_EXACT_ALARM: concessa all'installazione su Android 13+;
           SCHEDULE_EXACT_ALARM: per Android 12 e sotto — v4.124: con
           maxSdkVersion 32, perché da 13 in su è USE_EXACT_ALARM a
           coprire e la dichiarazione ridondante non serve più ) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <permission android:name="${applicationId}.permission.C2D_MESSAGE" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.C2D_MESSAGE" />

    <!-- v4.100: aggiornamento che fa tutto da solo. L'app scarica l'APK
         della nuova versione dentro la sua cache e apre DA SOLA
         l'installer di Android (stesso meccanismo di apriConApp per i
         PDF, gia' in produzione). Da Android 8 il sistema esige questo
         permesso per lanciare l'installer su un APK: senza, il tocco su
         "Aggiorna ora" restava muto. Non fa comparire alcuna richiesta
         a runtime: la prima volta Android mostra solo il suo interruttore
         "Installa app sconosciute", poi sempre la solita conferma
         "Aggiorna app?". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- v4.92: da Android 11 l'app non vede le app che aprono siti (browser)
         se non le dichiara qui: senza queste righe il tocco sui link dei
         messaggi restava muto perche' Linking non trovava nessuno che
         potesse aprire http/https (package visibility). -->
    <queries>
      <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:scheme="https" />
      </intent>
      <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:scheme="http" />
      </intent>
    </queries>
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- v4.6: il server mette in ogni push "clickAction: FCM_PLUGIN_ACTIVITY"
             (ereditato dal portale web di origine). Senza questo intent-filter
             Android non sa che schermata aprire quando il cliente TOCCA la
             notifica a app in background o chiusa: la notifica restava morta.
             Registrando MainActivity su quella azione, il tocco apre l'app
             e la libreria Firebase passa il messaggio all'app, che naviga
             alla tab/cartella/file giusti (deep-link). -->
        <intent-filter>
            <action android:name="FCM_PLUGIN_ACTIVITY" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
      </activity>
      <!-- v4.118: CONFLITTO MESSAGING_EVENT RISOLTO D'AUTHORITÀ. Nel
           manifest unito arrivano DUE FirebaseMessagingService: quello di
           expo-notifications (ExpoFirebaseMessagingService, dichiarato con
           intent-filter priority="-1") e quello di @react-native-firebase/
           messaging (ReactNativeFirebaseMessagingService, priority 0).
           Finora vinceva quello di RN Firebase SOLO perché ha priorità più
           alta: un rimescolamento del merge (o un aggiornamento della
           libreria) poteva spegnere onMessage/onTokenRefresh senza dire
           niente. L'app non usa MAI i token Expo (getToken viene da RN
           Firebase): il servizio di Expo si toglie dal merge, e il
           handler MESSAGING_EVENT resta uno solo, quello giusto. -->
      <service
        android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService"
        tools:node="remove" />

      <!-- v4.118: icona e colore di default delle push che ANDROID mostra
           quando l'app è CHIUSA (notification payload FCM): senza questi
           meta-data la barra di stato mostrava il quadratino bianco/grigio
           dell'icona launcher. L'icona è il logo PF monocromo bianco
           ic_stat_notification (in res/drawable-*: fino alla v4.121 era
           una campana, dalla v4.122 è il glifo PF del brand), il colore
           è l'oro del brand. tools:replace serve perché
           @react-native-firebase/messaging
           dichiara già default_notification_color col suo placeholder. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_notification" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/notifica_oro"
        tools:replace="android:resource" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="pfc-alerts-v2"
        tools:replace="android:value" />

      <!-- v4.120: STESSO LOGO anche per le notifiche LOCALI di
           expo-notifications (arrivi a app APERTA, preallarmi
           "Scade tra N giorni", sveglia "Scade OGGI", recupero).
           La libreria NON legge i meta-data Firebase qui sopra: ha
           i SUOI nomi (expo.modules.notifications.*) e senza questi
           ricadeva sull'icona launcher, che in barra di stato appare
           come il solito quadratino bianco senza logo. Con questi
           due meta-data anche le notifiche locali portano il glifo
           PF bianco ic_stat_notification e l'accento oro. -->
      <meta-data
        android:name="expo.modules.notifications.default_notification_icon"
        android:resource="@drawable/ic_stat_notification" />
      <meta-data
        android:name="expo.modules.notifications.default_notification_color"
        android:resource="@color/notifica_oro" />

      <!-- v4.122: LOGO PF A COLORI come icona GRANDE nelle notifiche
           locali (il riquadro oro con PF bianco, identico all'icona
           dell'app). expo-notifications legge questo meta-data e chiama
           setLargeIcon (verificato nel sorgente 0.29.14:
           META_DATA_LARGE_ICON_KEY). Nella tendina il logo si vede in
           pieno colore accanto al testo della notifica. -->
      <meta-data
        android:name="expo.modules.notifications.large_notification_icon"
        android:resource="@drawable/ic_notification_large" />
    </application>
</manifest>